<?xml version="1.0" ?>
<project xmlns="http://maven.apache.org/POM/4.0.0">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>dev.ghost</groupId>
    <artifactId>ghost-parent</artifactId>
    <version>1.0.0</version>
  </parent>
  <artifactId>ghost-app</artifactId>
  <dependencies>
    <dependency>
      <groupId>dev.ghost</groupId>
      <artifactId>ghost-connectors</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>org.pipelineframework</groupId>
      <artifactId>pipelineframework</artifactId>
      <version>26.10.1-20261027.142733-32</version>
    </dependency>
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-rest-jackson</artifactId>
    </dependency>
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-opentelemetry</artifactId>
    </dependency>
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-junit</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>io.rest-assured</groupId>
      <artifactId>rest-assured</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
  <build>
    <plugins>
      <plugin>
        <artifactId>maven-compiler-plugin</artifactId>
        <configuration>
          <annotationProcessorPathsUseDepMgmt>true</annotationProcessorPathsUseDepMgmt>
          <annotationProcessorPaths>
            <path>
              <groupId>org.pipelineframework</groupId>
              <artifactId>pipelineframework-compiler</artifactId>
              <version>26.10.1-20261026.143220-22</version>
            </path>
            <path>
              <groupId>org.pipelineframework</groupId>
              <artifactId>decision-query-connector</artifactId>
              <version>26.10.1-20261027.110129-21</version>
            </path>
            <path>
              <groupId>dev.ghost</groupId>
              <artifactId>ghost-connectors</artifactId>
              <version>${project.version}</version>
            </path>
          </annotationProcessorPaths>
        </configuration>
        <executions>
          <execution>
            <id>default-compile</id>
            <configuration>
              <compilerArgs>
                <arg>-Apipeline.config=${project.basedir}/src/main/resources/pipeline.yaml</arg>
                <arg>-Apipeline.generatedSourcesDir=${project.build.directory}/generated-sources/pipeline</arg>
                <arg>-Apipeline.module=ghost-app</arg>
              </compilerArgs>
            </configuration>
          </execution>
          <execution>
            <id>compile-orchestrator-client-generated</id>
            <phase>process-classes</phase>
            <goals>
              <goal>compile</goal>
            </goals>
            <configuration>
              <proc>none</proc>
              <compileSourceRoots>
                <compileSourceRoot>${project.build.directory}/generated-sources/pipeline/orchestrator-client</compileSourceRoot>
              </compileSourceRoots>
            </configuration>
          </execution>
          <execution>
            <id>default-testCompile</id>
            <configuration>
              <proc>none</proc>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>io.quarkus</groupId>
        <artifactId>quarkus-maven-plugin</artifactId>
        <extensions>true</extensions>
        <executions>
          <execution>
            <goals>
              <goal>build</goal>
              <goal>generate-code</goal>
              <goal>generate-code-tests</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
